.home-page { min-height: 100vh; }
.hero { position: relative; height: 620rpx; overflow: hidden; background: linear-gradient(135deg, #1f6b31, #86bd48); }
.hero-bg { position: absolute; right: -120rpx; bottom: -160rpx; width: 560rpx; height: 560rpx; border-radius: 50%; background: rgba(255,255,255,.16); box-shadow: -240rpx -160rpx 0 rgba(255,255,255,.08); }
.hero-content { position: relative; padding: 70rpx 38rpx 0; color: #fff; }
.brand-row { display: flex; align-items: center; gap: 20rpx; }
.brand-logo { width: 86rpx; height: 86rpx; border-radius: 26rpx; background: rgba(255,255,255,.95); color: #2f7d32; display: flex; align-items: center; justify-content: center; font-size: 42rpx; font-weight: 900; }
.brand-title { font-size: 40rpx; font-weight: 900; }
.brand-subtitle { font-size: 24rpx; opacity: .92; margin-top: 4rpx; }
.hero-title { margin-top: 62rpx; width: 620rpx; font-size: 54rpx; line-height: 1.16; font-weight: 900; letter-spacing: 1rpx; }
.hero-desc { margin-top: 24rpx; width: 620rpx; font-size: 28rpx; line-height: 1.7; opacity: .94; }
.hero-actions { display: flex; gap: 22rpx; margin-top: 38rpx; }
.hero-btn { margin: 0; width: 210rpx; height: 76rpx; line-height: 76rpx; border-radius: 999rpx; background: #fff; color: #247a33; font-size: 28rpx; font-weight: 800; }
.hero-btn.ghost { background: rgba(255,255,255,.18); color: #fff; border: 1rpx solid rgba(255,255,255,.55); }
.home-container { margin-top: -72rpx; position: relative; z-index: 2; }
.quick-card { display: grid; grid-template-columns: repeat(3, 1fr); padding: 28rpx 16rpx; }
.quick-item { text-align: center; padding: 8rpx 0; }
.quick-icon { width: 76rpx; height: 76rpx; margin: 0 auto 12rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.quick-icon.green { background: #eaf8ed; } .quick-icon.orange { background: #fff2df; } .quick-icon.blue { background: #eaf4ff; }
.quick-text { font-size: 30rpx; color: #243324; font-weight: 800; }
.quick-sub { font-size: 22rpx; color: #8a9284; margin-top: 4rpx; }
.category-scroll { white-space: nowrap; width: 100%; }
.category-list { display: flex; gap: 18rpx; padding: 2rpx 2rpx 8rpx; }
.category-pill { flex: 0 0 auto; min-width: 190rpx; padding: 24rpx 22rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 12rpx 28rpx rgba(36,82,43,.07); }
.category-pill.active { background: #2f7d32; color: #fff; }
.category-name { font-size: 28rpx; font-weight: 800; }
.category-desc { font-size: 22rpx; color: #7c8a75; margin-top: 10rpx; }
.category-pill.active .category-desc { color: rgba(255,255,255,.82); }
.product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22rpx; }
.product-card { min-height: 480rpx; }
.product-img { width: 100%; height: 245rpx; background: #e8efe2; }
.product-info { padding: 18rpx; }
.product-title { font-size: 28rpx; height: 76rpx; line-height: 38rpx; font-weight: 800; color: #172717; overflow: hidden; }
.price-row { margin-top: 8rpx; font-size: 28rpx; }
.tag-row { height: 50rpx; overflow: hidden; margin-top: 10rpx; }
.product-meta { margin-top: 12rpx; color: #879080; font-size: 22rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.story-list { display: flex; flex-direction: column; gap: 22rpx; }
.story-card { display: flex; padding: 18rpx; gap: 20rpx; }
.story-img { width: 205rpx; height: 155rpx; border-radius: 20rpx; background: #e8efe2; flex-shrink: 0; }
.story-body { flex: 1; min-width: 0; }
.story-title { font-size: 30rpx; font-weight: 900; color: #172717; line-height: 42rpx; }
.story-summary { margin-top: 10rpx; color: #6f7969; font-size: 24rpx; line-height: 34rpx; height: 68rpx; overflow: hidden; }
.story-meta { margin-top: 12rpx; color: #9aa293; font-size: 22rpx; }
