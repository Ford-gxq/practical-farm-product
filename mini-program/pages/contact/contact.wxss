.contact-hero {
  margin: 24rpx;
  padding: 52rpx 34rpx;
  border-radius: 38rpx;
  color: #fff;
  background: linear-gradient(135deg, #1d6f34 0%, #65a832 58%, #f4c95d 120%);
  box-shadow: 0 18rpx 44rpx rgba(47,125,50,.24);
  position: relative;
  overflow: hidden;
}
.contact-hero::after {
  content: '';
  position: absolute;
  right: -70rpx;
  bottom: -90rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.18);
}
.contact-badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,.2);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  font-weight: 800;
}
.contact-title { margin-top: 18rpx; font-size: 50rpx; font-weight: 900; }
.contact-desc { margin-top: 16rpx; font-size: 27rpx; line-height: 1.75; opacity: .96; position: relative; z-index: 1; }
.contact-card { padding: 32rpx; margin-bottom: 24rpx; }
.card-title { font-size: 34rpx; font-weight: 900; color: #183d20; margin-bottom: 22rpx; }
.desc-line { color: #5e6a58; font-size: 27rpx; line-height: 1.9; }
.notice-card { border: 2rpx solid rgba(82, 151, 64, .12); }
.form-card { background: #ffffff; }
.form-item { margin-bottom: 26rpx; }
.label { font-size: 26rpx; color: #4f5d4b; margin-bottom: 12rpx; font-weight: 800; }
input, textarea {
  width: 100%;
  background: #f7faf2;
  border-radius: 22rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2a1f;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}
input { height: 86rpx; }
textarea { height: 190rpx; padding-top: 22rpx; line-height: 1.65; }
.submit {  width: 360rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-radius: 44rpx;
  background: #2f9b45;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  text-align: center;
}
.tips { margin-top: 18rpx; color: #9aa293; font-size: 23rpx; line-height: 1.7; }
.admin-card { background: linear-gradient(180deg, #fff, #f9fbf3); }
.admin-step { color: #475544; font-size: 27rpx; line-height: 1.9; }
