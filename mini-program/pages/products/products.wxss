.products-page { min-height: 100vh; }
.top-filter { position: sticky; top: 0; z-index: 8; padding: 22rpx 24rpx 18rpx; background: linear-gradient(180deg, #f6f8ef 0%, rgba(246,248,239,.94) 100%); backdrop-filter: blur(12rpx); }
.search-box { height: 82rpx; display: flex; align-items: center; gap: 12rpx; padding: 0 24rpx; background: #fff; border-radius: 999rpx; box-shadow: 0 10rpx 28rpx rgba(36,82,43,.07); }
.search-icon { font-size: 28rpx; }
.search-box input { flex: 1; font-size: 28rpx; }
.clear { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; color: #899184; font-size: 36rpx; }
.tabs { margin-top: 20rpx; white-space: nowrap; }
.tab-list { display: flex; gap: 16rpx; }
.tab { flex: 0 0 auto; height: 62rpx; line-height: 62rpx; padding: 0 24rpx; border-radius: 999rpx; color: #66715f; background: #fff; font-size: 26rpx; box-shadow: 0 8rpx 20rpx rgba(36,82,43,.05); }
.tab.active { background: #2f7d32; color: #fff; font-weight: 800; }
.list-container { padding-top: 6rpx; }
.summary-card { display: flex; justify-content: space-between; align-items: center; padding: 28rpx; margin-bottom: 22rpx; background: linear-gradient(135deg, #ffffff, #f0faed); }
.summary-title { font-size: 36rpx; font-weight: 900; color: #183d20; }
.summary-desc { margin-top: 8rpx; color: #7a856f; font-size: 24rpx; }
.summary-count { color: #2f7d32; font-weight: 900; font-size: 30rpx; }
.product-list { display: flex; flex-direction: column; gap: 22rpx; }
.product-card { display: flex; padding: 18rpx; gap: 20rpx; }
.product-img { width: 240rpx; height: 240rpx; flex-shrink: 0; border-radius: 22rpx; background: #e8efe2; }
.product-body { flex: 1; min-width: 0; }
.product-title { font-size: 32rpx; font-weight: 900; line-height: 42rpx; color: #172717; }
.product-summary { margin-top: 10rpx; height: 68rpx; line-height: 34rpx; overflow: hidden; color: #6f7969; font-size: 24rpx; }
.tag-row { margin-top: 14rpx; height: 48rpx; overflow: hidden; }
.bottom-row { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 12rpx; }
.price { font-size: 30rpx; }
.origin { margin-top: 4rpx; color: #9aa293; font-size: 22rpx; max-width: 260rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.consult { width: 92rpx; height: 56rpx; line-height: 56rpx; text-align: center; color: #fff; background: #2f7d32; border-radius: 999rpx; font-size: 24rpx; font-weight: 800; }
.load-more { text-align: center; color: #9aa293; padding: 36rpx 0; font-size: 24rpx; }
