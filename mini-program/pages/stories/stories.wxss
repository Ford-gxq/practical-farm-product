.story-hero { margin: 24rpx; padding: 46rpx 34rpx; border-radius: 34rpx; color: #fff; background: linear-gradient(135deg, #6f9f2f, #2f7d32); box-shadow: 0 16rpx 36rpx rgba(47,125,50,.2); }
.story-title-main { font-size: 48rpx; font-weight: 900; }
.story-desc-main { margin-top: 14rpx; font-size: 27rpx; opacity: .94; }
.story-list { display: flex; flex-direction: column; gap: 24rpx; }
.story-card { overflow: hidden; }
.story-img { width: 100%; height: 360rpx; display: block; background: #e8efe2; }
.story-body { padding: 26rpx; }
.story-title { font-size: 34rpx; line-height: 46rpx; font-weight: 900; color: #172717; }
.story-summary { margin-top: 14rpx; color: #6f7969; font-size: 26rpx; line-height: 42rpx; }
.story-meta { display: flex; justify-content: space-between; margin-top: 22rpx; color: #9aa293; font-size: 23rpx; }
.load-more { text-align: center; color: #9aa293; padding: 36rpx 0; font-size: 24rpx; }
